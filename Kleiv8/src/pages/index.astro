---
import Layout from '../layouts/Layout.astro';
import MoodSlider from '../components/MoodSlider.astro';
import VibeCanvas from '../components/VibeCanvas.astro';
import QuickList from '../components/QuickList.astro';
import StoryDoodles from '../components/StoryDoodles.astro';
import BrandMark from '../components/BrandMark.astro';
import { VISUAL_ASSETS } from '../config/visual-assets.js';
import { SITE_CONFIG } from '../config/site.js';
---

<Layout
  title="KLEIV ∞ | Enjoy Coffee, Enjoy Vibes"
  titleAr="كليف ∞ | استمتع بالقهوة، استمتع بالأجواء"
  description="Specialty coffee and comfort space in Suez, Egypt. Counter service, pay in EGP."
  descriptionAr="قهوة مختصة ومساحة مريحة في السويس، مصر. اطلب وادفع بالجنيه المصري عند الكاشير."
>
  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero__copy">
        <p class="eyebrow"><span class="status-dot"></span><span data-i18n="heroEyebrow">Specialty Coffee · Suez, Egypt</span></p>
        <h1><span data-i18n="tagline">Enjoy Coffee. Enjoy Vibes</span></h1>
        <p class="hero__description" data-i18n="heroDescription">Find your signature brew or discover a daily comfort ritual. Explore the endless reel below, then order at the counter.</p>
        <div class="hero__actions">
          <a class="button-primary" href="#vibe-engine"><span data-i18n="explore">Explore Reel</span> <span aria-hidden="true">↓</span></a>
          <span class="payment-note"><span aria-hidden="true">◉</span> <span data-i18n="counterService">Counter Service · EGP</span></span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art__orbit">
          <img
            class="hero-art__cup"
            src={VISUAL_ASSETS.icedCupSlogan.src}
            data-i18n-src-en={VISUAL_ASSETS.icedCupSlogan.src}
            data-i18n-src-ar={VISUAL_ASSETS.icedCup.src}
            width={VISUAL_ASSETS.icedCupSlogan.width}
            height={VISUAL_ASSETS.icedCupSlogan.height}
            alt=""
            fetchpriority="high"
          />
        </div>
        <div class="hero-art__sticker hero-art__sticker--lounger">
          <img
            src={VISUAL_ASSETS.croissantLounger.src}
            width={VISUAL_ASSETS.croissantLounger.width}
            height={VISUAL_ASSETS.croissantLounger.height}
            alt=""
          />
        </div>
        <div class="hero-art__sticker hero-art__sticker--ice">
          <img
            src={VISUAL_ASSETS.meltingIce.src}
            width={VISUAL_ASSETS.meltingIce.width}
            height={VISUAL_ASSETS.meltingIce.height}
            alt=""
          />
        </div>
        <span class="hero-art__caption"><BrandMark class="hero-art__caption-mark" tone="cream" /> <span data-i18n="heroCaption">SUEZ · ENDLESS VIBES</span></span>
      </div>
    </section>

    <div class="content-wrap">
      <MoodSlider />
      <VibeCanvas />
      <StoryDoodles />
      <QuickList />
    </div>

    <section class="counter-callout" aria-label="How ordering works" data-i18n-aria="counterRegion">
      <div class="counter-callout__illustration" aria-hidden="true">
        <img
          src={VISUAL_ASSETS.slowMoment.src}
          width={VISUAL_ASSETS.slowMoment.width}
          height={VISUAL_ASSETS.slowMoment.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="counter-callout__copy">
        <p class="eyebrow" data-i18n="counterEyebrow">Simple Counter Flow</p>
        <h2 data-i18n="counterTitle">Order here. Pay at the cashier.</h2>
        <p data-i18n="counterCopy">Pick your drinks and pastries into your bag, send the list to our cashier on WhatsApp, and grab your vibe fresh from the bar.</p>
      </div>
      <a href={`https://wa.me/${SITE_CONFIG.whatsappNumber}`} target="_blank" rel="noopener noreferrer">
        <span data-i18n="chatBarista">Chat with Barista</span> <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <a class="footer-brand" href="#top" data-i18n-aria="homeLink"><BrandMark class="footer-brand__mark" /> <span data-i18n="brandName">KLEIV</span></a>
    <p data-i18n="footerLocation">Behind Engineers Syndicate · Suez, Egypt</p>
    <nav class="footer-socials" aria-label="Follow KLEIV on social media" data-i18n-aria="socialNavigation">
      {SITE_CONFIG.socialLinks.map(({ name, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Follow KLEIV on ${name}`}
          data-i18n-aria={`follow${name}`}
        >
          <span data-i18n={`social${name}`}>{name}</span>
        </a>
      ))}
    </nav>
    <p>© {new Date().getFullYear()} <span data-i18n="footerCopyright">KLEIV. Enjoy Coffee, Enjoy Vibes.</span></p>
  </footer>
</Layout>