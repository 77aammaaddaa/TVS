---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  titleAr="الصفحة غير موجودة"
  description="The page you requested could not be found."
  descriptionAr="تعذر العثور على الصفحة التي طلبتها."
>
  <main id="main-content" class="not-found">
    <p class="eyebrow" data-i18n="notFoundEyebrow">A little detour</p>
    <h1 data-i18n="notFoundTitle">This page wandered off.</h1>
    <a class="button-primary" href="/">
      <span data-i18n="backToMenu">Back to the menu</span>
      <span aria-hidden="true">↗</span>
    </a>
  </main>
</Layout>
