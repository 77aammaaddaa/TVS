---
import '../styles/global.css';
import Splash from '../components/Splash.astro';
import Header from '../components/Header.astro';
import AsmrPrompt from '../components/AsmrPrompt.astro';
import LatteArtModal from '../components/LatteArtModal.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { SITE_CONFIG } from '../config/site.js';
import { VISUAL_ASSETS } from '../config/visual-assets.js';

const { title = SITE_CONFIG.name, description = 'A little coffee ritual in Suez, Egypt.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        let lang = 'en';
        try { lang = localStorage.getItem('kleiv_lang') === 'ar' ? 'ar' : 'en'; } catch {}
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,400;0,600;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#213a23" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preload" as="image" href={VISUAL_ASSETS.infinity.src} />
    <title>{title} · Coffee, comfort & good company</title>
  </head>
  <body data-mode="vibe">
    <a class="skip-link" href="#main-content">Skip to menu</a>
    <Splash />
    <Header />
    <slot />
    <LatteArtModal />
    <AsmrPrompt />
    <CartDrawer />
    <script>
      import { applyLanguage, getLanguage } from '../scripts/language.js';
      applyLanguage(getLanguage());
    </script>
  </body>
</html>
