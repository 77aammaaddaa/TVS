---
import BrandMark from './BrandMark.astro';
---

<div class="splash" id="splash-screen" role="presentation">
  <div class="splash__atmosphere" aria-hidden="true"></div>
  <div class="splash__stage">
    <div class="splash__glow-ring" aria-hidden="true"></div>
    <BrandMark class="splash__infinity-mark" tone="cream" />
    <h1 class="splash__logo">KLEIV</h1>
    <p class="splash__slogan">ENJOY COFFEE · ENJOY VIBES</p>
    <button class="splash__skip" id="splash-enter" type="button">Enter menu <span aria-hidden="true">↓</span></button>
  </div>
</div>

<script>
  const splash = document.querySelector('#splash-screen');
  const enterButton = document.querySelector<HTMLButtonElement>('#splash-enter');
  let dismissed = false;

  function exitSplash() {
    if (dismissed || !splash) return;
    dismissed = true;
    splash.classList.add('splash--exit');
    window.setTimeout(() => {
      splash.remove();
      window.dispatchEvent(new CustomEvent('kleiv8:menu-ready'));
    }, 800);
  }

  enterButton?.addEventListener('click', exitSplash);
  splash?.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Element && event.target.closest('button')) return;
    exitSplash();
  }, { once: true });

  window.setTimeout(exitSplash, 1200);
</script>