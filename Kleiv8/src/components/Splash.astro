<div class="splash" id="splash-screen" role="presentation">
  <div class="splash__atmosphere" aria-hidden="true"></div>
  <div class="splash__stage">
    <div class="splash__glow-ring" aria-hidden="true"></div>
    <svg class="splash__infinity-svg" viewBox="0 0 200 100" fill="none" aria-label="KLEIV Infinity Loop">
      <path
        class="infinity-track"
        d="M 50,50 C 20,20 5,35 5,50 C 5,65 20,80 50,50 C 80,20 100,50 100,50 C 100,50 120,80 150,50 C 180,20 195,35 195,50 C 195,65 180,80 150,50 C 120,20 100,50 100,50 Z"
      />
      <path
        class="infinity-pulse"
        d="M 50,50 C 20,20 5,35 5,50 C 5,65 20,80 50,50 C 80,20 100,50 100,50 C 100,50 120,80 150,50 C 180,20 195,35 195,50 C 195,65 180,80 150,50 C 120,20 100,50 100,50 Z"
      />
    </svg>
    <h1 class="splash__logo">KLEIV</h1>
    <p class="splash__slogan">ENJOY COFFEE · ENJOY VIBES</p>
  </div>
</div>

<script>
  import { audioController } from '../scripts/audio-controller.js';

  const splash = document.querySelector('#splash-screen');
  let dismissed = false;

  async function exitSplash() {
    if (dismissed || !splash) return;
    dismissed = true;
    splash.classList.add('splash--exit');
    await audioController.playClick();
    await audioController.startMusic();
    window.setTimeout(() => splash.remove(), 800);
  }

  // Starts music immediately on first user touch anywhere
  window.addEventListener('pointerdown', () => {
    audioController.startMusic();
    exitSplash();
  }, { once: true });

  // Automatic cinematic exit after the infinity loop finishes drawing
  window.setTimeout(exitSplash, 2400);
</script>