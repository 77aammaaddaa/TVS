<section class="mood-panel" aria-labelledby="mood-title">
  <div class="mood-panel__heading">
    <div>
      <p class="eyebrow" data-i18n="chooseMood">Choose your feeling</p>
      <h2 id="mood-title" data-i18n="moodQuestion">What’s the mood?</h2>
    </div>
    <span id="mood-current" class="mood-current" data-i18n="chill">Chill</span>
  </div>
  <div
    class="mood-control"
    role="group"
    aria-label="Filter menu by mood"
    data-i18n-aria="filterMood"
  >
    <button
      type="button"
      class="mood-button is-active"
      data-mood-option="chill"
      aria-pressed="true"
      data-i18n="chill"
    >
      Chill
    </button>
    <button
      type="button"
      class="mood-button"
      data-mood-option="focus"
      aria-pressed="false"
      data-i18n="focus"
    >
      Focus
    </button>
    <button
      type="button"
      class="mood-button"
      data-mood-option="refresh"
      aria-pressed="false"
      data-i18n="refresh"
    >
      Refresh
    </button>
  </div>
</section>

<script>
  import { LANGUAGE_UPDATED_EVENT, getLanguage, t } from '../scripts/language.js';

  const moodButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mood-option]'));
  const currentMood = document.querySelector<HTMLElement>('#mood-current');

  const renderMood = () => {
    const mood = moodButtons.find((button) => button.getAttribute('aria-pressed') === 'true')
      ?.dataset.moodOption ?? 'chill';
    const label = t(mood, getLanguage());

    if (currentMood) currentMood.textContent = label;
    moodButtons.forEach((button) => {
      const isActive = button.dataset.moodOption === mood;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  };

  moodButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mood = button.dataset.moodOption;
      if (!mood) {
        console.error('Mood button is missing its mood value.');
        return;
      }

      moodButtons.forEach((option) => {
        option.setAttribute('aria-pressed', String(option === button));
      });
      renderMood();
      window.dispatchEvent(new CustomEvent('kleiv8:mood-change', { detail: { mood } }));
    });
  });

  window.addEventListener(LANGUAGE_UPDATED_EVENT, renderMood);
  renderMood();
</script>
