---
import Menu from '../../public/data/default-menu.json';
import { doodleForMenuItem, getDoodleMarkup } from '../scripts/doodles.js';
const categories = [...new Set(Menu.map((item) => item.category))];
---

<section class="speed-section" id="speed-engine" aria-label="Quick order menu">
  <div class="section-heading speed-heading">
    <div>
      <p class="eyebrow" data-i18n="quickEyebrow">Quick list · counter ready</p>
      <h2><span data-i18n="quickTitle1">Pick. Pay.</span> <em data-i18n="quickTitle2">Enjoy.</em></h2>
    </div>
    <label class="search-field">
      <span class="sr-only">Search the menu</span>
      <span aria-hidden="true">⌕</span>
      <input id="menu-search" type="search" data-i18n-placeholder="search" placeholder="Search / ابحث" autocomplete="off" />
    </label>
  </div>
  <div class="category-tabs" id="category-tabs" aria-label="Filter by category">
    <button class="category-tab is-selected" type="button" data-category="all" aria-pressed="true" data-i18n="everything">Everything</button>
    {categories.map((category) => (
      <button class="category-tab" type="button" data-category={category} aria-pressed="false">{category}</button>
    ))}
  </div>
  <div class="quick-list" id="quick-list">
    {Menu.filter((item) => item.status !== 'Hidden').map((item) => (
      <article class="quick-item" data-id={item.id} data-category={item.category} data-name={`${item.name_en} ${item.name_ar}`.toLowerCase()}>
        <div class="quick-item__doodle" set:html={getDoodleMarkup(doodleForMenuItem(item))}></div>
        <div class="quick-item__copy">
          <strong>{item.name_en}</strong>
          <span lang="ar" dir="rtl">{item.name_ar}</span>
          <small>{item.category}</small>
        </div>
        <div class="quick-item__actions">
          <strong class="quick-item__price">{item.price} <small>EGP</small></strong>
          {item.latte_art && (
            <button
              class="latte-art-trigger"
              type="button"
              data-latte-art={item.id}
              aria-label={`See latte art for ${item.name_en}`}
              title={`See latte art for ${item.name_en}`}
            >∞</button>
          )}
          <button class="quick-add" type="button" data-add-item={item.id} aria-label={`Add ${item.name_en} to order`}>Add</button>
        </div>
      </article>
    ))}
  </div>
  <p class="empty-search hidden" id="empty-search" data-i18n="noResults">No menu items match your search.</p>
</section>

<script>
  import Menu from '../../public/data/default-menu.json';
  import { doodleForMenuItem, getDoodleMarkup } from '../scripts/doodles.js';
  import { menuStore, MENU_UPDATED_EVENT } from '../scripts/menu-store.js';
  import { asmr } from '../scripts/asmr-engine.js';
  import { getLanguage, LANGUAGE_UPDATED_EVENT, applyLanguage, itemName, categoryName, t } from '../scripts/language.js';

  type MenuItem = {
    id: string;
    category: string;
    name_en: string;
    name_ar: string;
    description: string;
    price: number;
    status: string;
    emoji?: string;
    latte_art?: boolean;
  };

  const fallback: MenuItem[] = Menu;
  const list = document.querySelector<HTMLElement>('#quick-list');
  const search = document.querySelector<HTMLInputElement>('#menu-search');
  const emptyMessage = document.querySelector<HTMLElement>('#empty-search');
  let selectedCategory = 'all';
  let searchTerm = '';

  function renderItems(items: MenuItem[]) {
    if (!list) return;
    list.replaceChildren(...items.filter((item) => item.status !== 'Hidden').map((item) => {
      const row = document.createElement('article');
      row.className = `quick-item${item.status === 'Sold Out' ? ' is-sold-out' : ''}`;
      row.dataset.id = item.id;
      row.dataset.category = item.category;
      row.dataset.name = `${item.name_en} ${item.name_ar}`.toLowerCase();
      const doodle = document.createElement('div');
      doodle.className = 'quick-item__doodle';
      doodle.innerHTML = getDoodleMarkup(doodleForMenuItem(item));
      const copy = document.createElement('div');
      copy.className = 'quick-item__copy';
      const title = document.createElement('strong');
      title.textContent = itemName(item);
      const arabic = document.createElement('span');
      arabic.lang = getLanguage() === 'ar' ? 'ar' : 'en';
      arabic.dir = getLanguage() === 'ar' ? 'rtl' : 'ltr';
      arabic.textContent = getLanguage() === 'ar' ? item.name_ar : item.name_en;
      arabic.hidden = getLanguage() === 'ar' && !item.name_ar;
      const category = document.createElement('small');
      category.textContent = categoryName(item.category);
      copy.append(title, arabic, category);
      const price = document.createElement('strong');
      price.className = 'quick-item__price';
      price.textContent = `${item.price} EGP`;
      const actions = document.createElement('div');
      actions.className = 'quick-item__actions';
      actions.append(price);
      if (item.latte_art) {
        const latteArt = document.createElement('button');
        latteArt.className = 'latte-art-trigger';
        latteArt.type = 'button';
        latteArt.dataset.latteArt = item.id;
        latteArt.textContent = '∞';
        latteArt.setAttribute('aria-label', `See latte art for ${item.name_en}`);
        latteArt.title = `See latte art for ${item.name_en}`;
        actions.append(latteArt);
      }
      const add = document.createElement('button');
      add.className = 'quick-add';
      add.type = 'button';
      add.dataset.addItem = item.id;
      add.disabled = item.status === 'Sold Out';
      add.textContent = item.status === 'Sold Out' ? t('soldOut') : t('add');
      add.setAttribute('aria-label', `${t('add')} ${itemName(item)}`);
      actions.append(add);
      row.append(doodle, copy, actions);
      return row;
    }));
    filterItems();
  }

  function filterItems() {
    let visibleCount = 0;
    list?.querySelectorAll<HTMLElement>('.quick-item').forEach((row) => {
      const matchesCategory = selectedCategory === 'all' || row.dataset.category === selectedCategory;
      const matchesSearch = row.dataset.name?.includes(searchTerm) ?? false;
      const visible = matchesCategory && matchesSearch;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    emptyMessage?.classList.toggle('hidden', visibleCount > 0);
  }

  search?.addEventListener('input', () => {
    searchTerm = search.value.trim().toLocaleLowerCase();
    filterItems();
  });

  document.querySelector('#category-tabs')?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-category]');
    if (!button) return;
    const category = button.dataset.category;
    if (!category) return;
    selectedCategory = category;
    if (category !== 'all') await asmr.playCategory(category);
    document.querySelectorAll<HTMLButtonElement>('.category-tab').forEach((tab) => {
      const selected = tab === button;
      tab.classList.toggle('is-selected', selected);
      tab.setAttribute('aria-pressed', String(selected));
    });
    filterItems();
  });

  list?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const latteArtButton = target.closest<HTMLButtonElement>('[data-latte-art]');
    if (latteArtButton) {
      const item = menuStore.getMenu().find((entry) => entry.id === latteArtButton.dataset.latteArt);
      if (item) {
        window.dispatchEvent(new CustomEvent('kleiv8:latte-art-open', { detail: { name: itemName(item) } }));
      }
      return;
    }
    const button = target.closest<HTMLButtonElement>('[data-add-item]');
    if (!button || button.disabled) return;
    const item = menuStore.getMenu().find((entry) => entry.id === button.dataset.addItem);
    if (!item) return;
    menuStore.addToCart(item);
    button.textContent = t('added');
    window.setTimeout(() => {
      if (button.isConnected) button.textContent = t('add');
    }, 700);
  });

  menuStore.subscribe(MENU_UPDATED_EVENT, (event: CustomEvent<MenuItem[]>) => renderItems(event.detail));
  window.addEventListener(LANGUAGE_UPDATED_EVENT, () => {
    applyLanguage(getLanguage());
    document.querySelectorAll<HTMLButtonElement>('.category-tab').forEach((tab) => {
      const category = tab.dataset.category;
      tab.textContent = category === 'all' ? t('everything') : categoryName(category ?? 'Menu');
    });
    renderItems(menuStore.getMenu());
  });
  menuStore.init(fallback);
</script>
