---
import { STORY_DOODLES } from '../config/story-doodles.js';
import { getKleivSvgMarkup } from '../scripts/kleiv-svg.js';
import BrandMark from './BrandMark.astro';
---

<section class="story-doodles-section" id="story-doodles" aria-labelledby="story-doodles-title">
  <header class="story-header">
    <p class="eyebrow" data-i18n="storyEyebrow">Interactive moments</p>
    <h2 id="story-doodles-title"><span data-i18n="storyTitle1">Every little detail has a</span> <em data-i18n="storyTitle2">story.</em></h2>
    <p data-i18n="storyDescription">Scroll through five KLEIV moments and find a little pick for yours.</p>
  </header>

  <div class="story-chapters" id="story-chapters">
    {STORY_DOODLES.map((story, index) => (
      <article
        class:list={['story-chapter', index % 2 === 1 && 'story-chapter--reverse']}
        data-story-chapter={story.id}
        data-story-label-en={story.label_en}
        data-story-label-ar={story.label_ar}
        data-story-badge-en={story.badge_en}
        data-story-badge-ar={story.badge_ar}
        data-story-title-en={story.title_en}
        data-story-title-ar={story.title_ar}
        data-story-copy-en={story.copy_en}
        data-story-copy-ar={story.copy_ar}
        data-recommendation-ids={story.recommendationIds.join(',')}
      >
        <div class="story-chapter__art" aria-hidden="true">
          {story.svgKey === 'infinity_loop' ? (
            <div class="story-figure story-figure--brand">
              <BrandMark class="story-figure__brand" tone="cream" />
            </div>
          ) : (
            <div class="story-figure" set:html={getKleivSvgMarkup(story.svgKey, { instance: story.id })}></div>
          )}
          <span class="story-chapter__number">{String(index + 1).padStart(2, '0')} / 05</span>
        </div>
        <div class="story-chapter__copy">
          <p class="eyebrow story-chapter__badge">{story.badge_en}</p>
          <h3 class="story-chapter__title">{story.title_en}</h3>
          <p class="story-chapter__description">{story.copy_en}</p>
          <div class="story-recommendations" data-story-recommendations aria-live="polite"></div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import Menu from '../../public/data/default-menu.json';
  import { asmr } from '../scripts/asmr-engine.js';
  import { MENU_UPDATED_EVENT, menuStore } from '../scripts/menu-store.js';
  import {
    categoryName,
    formatPrice,
    getLanguage,
    itemName,
    LANGUAGE_UPDATED_EVENT,
    t,
  } from '../scripts/language.js';

  type MenuItem = {
    id: string;
    name_en: string;
    name_ar?: string;
    price: number;
    status: string;
    category_en?: string;
    category_ar?: string;
  };

  const root = document.querySelector<HTMLElement>('#story-chapters');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function localizedValue(chapter: HTMLElement, key: 'label' | 'badge' | 'title' | 'copy') {
    const suffix = getLanguage() === 'ar' ? 'Ar' : 'En';
    const value = chapter.dataset[`story${key[0].toUpperCase()}${key.slice(1)}${suffix}`];
    return value || t('unknownStory');
  }

  function localizeChapters() {
    root?.querySelectorAll<HTMLElement>('[data-story-chapter]').forEach((chapter) => {
      const badge = chapter.querySelector<HTMLElement>('.story-chapter__badge');
      const title = chapter.querySelector<HTMLElement>('.story-chapter__title');
      const copy = chapter.querySelector<HTMLElement>('.story-chapter__description');
      if (badge) badge.textContent = localizedValue(chapter, 'badge');
      if (title) title.textContent = localizedValue(chapter, 'title');
      if (copy) copy.textContent = localizedValue(chapter, 'copy');
      renderRecommendations(chapter, menuStore.getMenu());
    });
  }

  function renderRecommendations(chapter: HTMLElement, menu: MenuItem[]) {
    const container = chapter.querySelector<HTMLElement>('[data-story-recommendations]');
    if (!container) return;
    const ids = chapter.dataset.recommendationIds?.split(',').filter(Boolean) ?? [];
    const items = ids
      .map((id) => menu.find((item) => item.id === id))
      .filter((item): item is MenuItem => Boolean(item && item.status !== 'Sold Out' && item.status !== 'Hidden'));

    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'story-recommendations__empty';
      empty.textContent = t('storyUnavailable');
      container.replaceChildren(empty);
      return;
    }

    container.replaceChildren(...items.map((item) => {
      const card = document.createElement('article');
      card.className = 'story-pick-card';
      const details = document.createElement('button');
      details.type = 'button';
      details.className = 'story-pick-card__details';
      details.dataset.openProduct = item.id;
      const name = document.createElement('strong');
      name.textContent = itemName(item);
      const category = document.createElement('small');
      category.textContent = `${categoryName(item)} · ${formatPrice(item.price)}`;
      details.append(name, category);
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'story-pick-card__add';
      add.dataset.addItem = item.id;
      add.textContent = '+';
      add.setAttribute('aria-label', t('addItemToBag').replace('{item}', itemName(item)));
      card.append(details, add);
      return card;
    }));
  }

  root?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const addButton = target.closest<HTMLButtonElement>('[data-add-item]');
    if (addButton) {
      const item = menuStore.getMenu().find((entry) => entry.id === addButton.dataset.addItem);
      if (!item || !menuStore.addToCart(item)) return;
      await asmr.playClick('add');
      addButton.classList.add('is-added');
      addButton.textContent = t('added');
      window.setTimeout(() => {
        if (addButton.isConnected) {
          addButton.classList.remove('is-added');
          addButton.textContent = '+';
        }
      }, 700);
      return;
    }
    const details = target.closest<HTMLButtonElement>('[data-open-product]');
    if (details) {
      const item = menuStore.getMenu().find((entry) => entry.id === details.dataset.openProduct);
      if (item) window.dispatchEvent(new CustomEvent('kleiv8:product-open', { detail: { item } }));
    }
  });

  function revealChapters() {
    const chapters = [...(root?.querySelectorAll<HTMLElement>('[data-story-chapter]') ?? [])];
    if (reducedMotion.matches || !('IntersectionObserver' in window)) {
      chapters.forEach((chapter) => {
        chapter.classList.add('is-in-view');
        chapter.querySelector('.svg-hybrid-draw')?.classList.add('is-live');
      });
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const chapter = entry.target as HTMLElement;
        chapter.classList.add('is-in-view');
        chapter.querySelector('.svg-hybrid-draw')?.classList.add('is-live');
        observer.unobserve(chapter);
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    chapters.forEach((chapter) => observer.observe(chapter));
  }

  window.addEventListener(LANGUAGE_UPDATED_EVENT, localizeChapters);
  menuStore.subscribe(MENU_UPDATED_EVENT, (event: CustomEvent<MenuItem[]>) => {
    root?.querySelectorAll<HTMLElement>('[data-story-chapter]').forEach((chapter) =>
      renderRecommendations(chapter, event.detail)
    );
  });
  if (reducedMotion.addEventListener) {
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) revealChapters();
    });
  }
  localizeChapters();
  revealChapters();
  menuStore.init(Menu);
</script>
