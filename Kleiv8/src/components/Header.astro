---
import BrandMark from './BrandMark.astro';
---

<header class="site-header">
  <a class="brand-lockup" href="#top" aria-label="KLEIV home">
    <span class="brand-mark"><BrandMark class="brand-mark__symbol" tone="cream" /></span>
    <span><strong>KLEIV</strong><small>Suez · Coffee & Vibes</small></span>
  </a>

  <nav class="header-actions" aria-label="Menu controls">
    <button class="language-toggle" id="language-toggle" type="button" aria-label="Change language">
      <span id="language-toggle-label">EN</span>
    </button>
    <button class="sound-toggle" id="sound-toggle" type="button" aria-pressed="false" aria-label="ASMR Ambient: off" title="Enable optional ASMR and rain ambience">
      <div class="sound-bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <span class="sound-label">ASMR Ambient</span>
    </button>
    <button class="mode-toggle" id="mode-toggle" type="button" aria-pressed="false">
      <span class="mode-toggle__dot" aria-hidden="true"></span>
      <span id="mode-label">Vibe Reel</span>
    </button>
    <button class="cart-trigger" id="open-cart-btn" type="button" aria-label="Open Cart">
      <span aria-hidden="true">Bag</span>
      <span class="cart-trigger__count hidden" id="cart-badge">0</span>
    </button>
  </nav>
</header>

<script>
  import { asmr, ASMR_STATE_EVENT } from '../scripts/asmr-engine.js';
  import { getLanguage, setLanguage, LANGUAGE_UPDATED_EVENT, t } from '../scripts/language.js';

  const languageToggle = document.querySelector<HTMLButtonElement>('#language-toggle');
  const languageLabel = document.querySelector<HTMLElement>('#language-toggle-label');

  function syncLanguageControl(lang: 'ar' | 'en') {
    if (languageLabel) languageLabel.textContent = lang === 'ar' ? 'EN' : 'عربي';
    languageToggle?.setAttribute('aria-label', lang === 'ar' ? 'Switch to English' : 'التبديل إلى العربية');
  }

  syncLanguageControl(getLanguage() as 'ar' | 'en');
  languageToggle?.addEventListener('click', async () => {
    const next = getLanguage() === 'ar' ? 'en' : 'ar';
    setLanguage(next);
    await asmr.playClick();
  });
  window.addEventListener(LANGUAGE_UPDATED_EVENT, (event) => {
    const lang = (event as CustomEvent<{ lang: 'ar' | 'en' }>).detail.lang;
    syncLanguageControl(lang);
    const label = document.querySelector<HTMLElement>('#mode-label');
    if (label) label.textContent = document.body.dataset.mode === 'speed' ? t('modeSpeed', lang) : t('modeVibe', lang);
  });

  const modeToggle = document.querySelector<HTMLButtonElement>('#mode-toggle');
  const modeLabel = document.querySelector<HTMLElement>('#mode-label');
  const soundButton = document.querySelector<HTMLButtonElement>('#sound-toggle');
  const soundLabel = soundButton?.querySelector<HTMLElement>('.sound-label');

  function updateSoundControl(enabled: boolean) {
    if (!soundButton) return;
    soundButton.setAttribute('aria-pressed', String(enabled));
    soundButton.setAttribute('aria-label', `ASMR Ambient: ${enabled ? 'on' : 'off'}`);
    soundButton.title = enabled ? 'Turn ASMR and rain ambience off' : 'Enable optional ASMR and rain ambience';
    if (soundLabel) soundLabel.textContent = 'ASMR Ambient';
    soundButton.querySelectorAll('.sound-bars span').forEach((bar) => {
      bar.classList.toggle('is-dancing', enabled);
    });
  }

  updateSoundControl(asmr.enabled);
  window.addEventListener(ASMR_STATE_EVENT, (event) => {
    const stateEvent = event as CustomEvent<{ enabled: boolean }>;
    updateSoundControl(stateEvent.detail.enabled);
  });

  modeToggle?.addEventListener('click', async () => {
    const isSpeed = document.body.dataset.mode !== 'speed';
    document.body.dataset.mode = isSpeed ? 'speed' : 'vibe';
    modeToggle.setAttribute('aria-pressed', String(isSpeed));
    if (modeLabel) {
      modeLabel.textContent = isSpeed ? t('modeSpeed') : t('modeVibe');
    }
    await asmr.playClick();
  });

  soundButton?.addEventListener('click', async () => {
    const enabled = await asmr.toggle();
    if (enabled) await asmr.playClick();
  });
</script>