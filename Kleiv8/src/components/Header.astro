<header class="site-header">
  <a class="brand-lockup" href="#top" aria-label="KLEIV home">
    <span class="brand-mark" aria-hidden="true">∞</span>
    <span><strong>KLEIV</strong><small>Suez · Coffee & Vibes</small></span>
  </a>

  <nav class="header-actions" aria-label="Menu controls">
    <button class="sound-toggle" id="sound-toggle" type="button" aria-pressed="false" title="Toggle Lo-Fi Music">
      <div class="sound-bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <span class="sound-label">Lo-Fi</span>
    </button>
    <button class="mode-toggle" id="mode-toggle" type="button" aria-pressed="false">
      <span class="mode-toggle__dot" aria-hidden="true"></span>
      <span id="mode-label">Vibe Reel</span>
    </button>
    <button class="cart-trigger" id="open-cart-btn" type="button" aria-label="Open Cart">
      <span aria-hidden="true">Bag</span>
      <span class="cart-trigger__count hidden" id="cart-badge">0</span>
    </button>
  </nav>
</header>

<script>
  import { audioController } from '../scripts/audio-controller.js';

  const modeToggle = document.querySelector<HTMLButtonElement>('#mode-toggle');
  const modeLabel = document.querySelector<HTMLElement>('#mode-label');
  const soundButton = document.querySelector<HTMLButtonElement>('#sound-toggle');

  modeToggle?.addEventListener('click', async () => {
    const isSpeed = document.body.dataset.mode !== 'speed';
    document.body.dataset.mode = isSpeed ? 'speed' : 'vibe';
    modeToggle.setAttribute('aria-pressed', String(isSpeed));
    if (modeLabel) {
      modeLabel.textContent = isSpeed ? 'Speed List' : 'Vibe Reel';
    }
    await audioController.playClick();
  });

  soundButton?.addEventListener('click', async () => {
    await audioController.toggleMusic();
  });
</script>