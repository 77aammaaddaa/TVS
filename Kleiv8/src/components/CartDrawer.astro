<div class="drawer-backdrop" id="cart-backdrop" hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-labelledby="cart-title" aria-hidden="true">
  <div class="cart-drawer__header">
    <div>
      <p class="eyebrow" data-i18n="orderEyebrow">Order & pay at cashier</p>
      <h2 id="cart-title"><span data-i18n="cartTitle">Your little list</span><span id="cart-item-count"></span></h2>
    </div>
    <button class="icon-button" id="close-cart-btn" type="button" aria-label="Close order" data-i18n-aria="closeCart">×</button>
  </div>
  <div class="cart-items" id="cart-items" aria-live="polite"></div>
  <label class="notes-field" for="order-notes">
    <span><span data-i18n="baristaNote">A note for the barista</span> <small data-i18n="optional">(optional)</small></span>
    <textarea id="order-notes" rows="2" maxlength="180" data-i18n-placeholder="notePlaceholder" placeholder="Milk preference, less ice…"></textarea>
  </label>
  <div class="cart-summary">
    <p><span data-i18n="total">Total</span><strong id="cart-total">0 EGP</strong></p>
    <p class="cashier-note" data-i18n="cashierNote">Send your order, then pay at our counter.</p>
    <button class="checkout-button" id="checkout-btn" type="button">
      <span data-i18n="sendCashier">Send to cashier on WhatsApp</span><span aria-hidden="true">↗</span>
    </button>
    <p class="cart-feedback" id="cart-feedback" role="status" aria-live="polite" hidden></p>
  </div>
</aside>

<script>
  import { doodleForMenuItem, getDoodleMarkup } from '../scripts/doodles.js';
  import { menuStore, CART_UPDATED_EVENT } from '../scripts/menu-store.js';
  import { checkoutViaWhatsApp } from '../scripts/order-handler.js';
  import { getLanguage, LANGUAGE_UPDATED_EVENT, applyLanguage, formatNumber, formatPrice, itemName, t } from '../scripts/language.js';

  type CartItem = {
    id: string;
    name_en: string;
    name_ar?: string;
    price: number;
    emoji: string;
    quantity: number;
  };

  const drawer = document.querySelector<HTMLElement>('#cart-drawer');
  const backdrop = document.querySelector<HTMLDivElement>('#cart-backdrop');
  const badge = document.querySelector<HTMLElement>('#cart-badge');
  const cartItems = document.querySelector<HTMLElement>('#cart-items');
  const cartTotal = document.querySelector<HTMLElement>('#cart-total');
  const countLabel = document.querySelector<HTMLElement>('#cart-item-count');
  const notes = document.querySelector<HTMLTextAreaElement>('#order-notes');
  const feedback = document.querySelector<HTMLElement>('#cart-feedback');
  let feedbackKey = '';

  function showFeedback(key: string) {
    feedbackKey = key;
    if (!feedback) return;
    feedback.textContent = key ? t(key) : '';
    feedback.hidden = !key;
  }

  function setDrawerOpen(open: boolean) {
    drawer?.classList.toggle('is-open', open);
    drawer?.setAttribute('aria-hidden', String(!open));
    if (backdrop) backdrop.hidden = !open;
    document.body.classList.toggle('drawer-open', open);
    if (open) document.querySelector<HTMLButtonElement>('#close-cart-btn')?.focus();
    else document.querySelector<HTMLButtonElement>('#open-cart-btn')?.focus();
  }

  function renderCart(cart: CartItem[]) {
    const quantity = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (badge) {
      badge.textContent = formatNumber(quantity);
      badge.classList.toggle('hidden', quantity === 0);
    }
    const openCartButton = document.querySelector<HTMLButtonElement>('#open-cart-btn');
    openCartButton?.setAttribute(
      'aria-label',
      quantity ? t('openCartCount').replace('{count}', formatNumber(quantity)) : t('openCart'),
    );
    if (countLabel) countLabel.textContent = quantity ? ` · ${formatNumber(quantity)}` : '';
    const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    if (cartTotal) cartTotal.textContent = formatPrice(total);
    if (!cartItems) return;

    if (cart.length === 0) {

      cartItems.innerHTML = `<div class="cart-empty"><span aria-hidden="true">☕</span><p>${t('emptyCart')}</p><small>${t('emptyCartHint')}</small></div>`;

      return;
    }
    cartItems.replaceChildren(...cart.map((item) => {
      const row = document.createElement('article');
      row.className = 'cart-line';
      const doodle = document.createElement('div');
      doodle.className = 'cart-line__doodle';
      doodle.innerHTML = getDoodleMarkup(doodleForMenuItem(item));
      const copy = document.createElement('div');
      copy.className = 'cart-line__copy';
      const name = document.createElement('strong');
      name.textContent = itemName(item);
      const amount = document.createElement('small');
      amount.textContent = `${formatPrice(item.price)} ${t('each')}`;
      copy.append(name, amount);
      const controls = document.createElement('div');
      controls.className = 'quantity-control';
      const decrement = document.createElement('button');
      decrement.type = 'button';
      decrement.dataset.change = '-1';
      decrement.dataset.itemId = item.id;
      decrement.setAttribute('aria-label', `${t('removeOne')} ${itemName(item)}`);
      decrement.textContent = '−';
      const value = document.createElement('span');
      value.textContent = formatNumber(item.quantity);
      const increment = document.createElement('button');
      increment.type = 'button';
      increment.dataset.change = '1';
      increment.dataset.itemId = item.id;
      increment.setAttribute('aria-label', `${t('addOne')} ${itemName(item)}`);
      increment.textContent = '+';
      controls.append(decrement, value, increment);
      row.append(doodle, copy, controls);
      return row;
    }));
  }

  document.querySelector<HTMLButtonElement>('#open-cart-btn')?.addEventListener('click', () => {
    setDrawerOpen(true);
  });
  document.querySelector<HTMLButtonElement>('#close-cart-btn')?.addEventListener('click', () => setDrawerOpen(false));
  backdrop?.addEventListener('click', () => setDrawerOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.classList.contains('is-open')) setDrawerOpen(false);
  });

  cartItems?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-change]');
    if (!button) return;
    menuStore.updateQuantity(button.dataset.itemId, Number(button.dataset.change));
  });

  document.querySelector('#checkout-btn')?.addEventListener('click', () => {
    const result = checkoutViaWhatsApp(menuStore.getCart(), notes?.value ?? '');
    if (!result.ok) {
      if (result.reason === 'empty-cart') {
        showFeedback('emptyCheckout');
      } else if (result.reason === 'note-language-mismatch') {
        showFeedback('notesLanguageError');
      } else if (result.reason === 'invalid-cart') {
        showFeedback('invalidCart');
      }
      return;
    }
    showFeedback('');
    menuStore.clearCart();
    if (notes) notes.value = '';
  });

  menuStore.subscribe(CART_UPDATED_EVENT, (event: CustomEvent<CartItem[]>) => renderCart(event.detail));
  window.addEventListener(LANGUAGE_UPDATED_EVENT, () => {
    applyLanguage(getLanguage());
    renderCart(menuStore.getCart());
    if (feedbackKey) showFeedback(feedbackKey);
  });
  menuStore.init();
  renderCart(menuStore.getCart());
</script>
