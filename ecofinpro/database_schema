z-- =============================================================================
-- EcoFin Pro — FULL DESTRUCTIVE DATABASE RESET + INITIALIZATION
-- Target: Supabase SQL Editor (Postgres)
--
-- ⚠️⚠️⚠️  WARNING — THIS SCRIPT DESTROYS ALL EXISTING DATA  ⚠️⚠️⚠️
-- Section 0 drops the entire `public` schema (every table, every row, every
-- function, every policy). There is no undo short of a backup restore.
-- Do NOT run this against a database with data you care about.
--
-- After this runs you MUST re-run the seed script
-- (001_seed_provider_org_and_super_admin.sql) to recreate your SaaS
-- provider organization and first super admin — that record is gone too.
--
-- Run top to bottom in one go.
-- =============================================================================

-- =============================================================================
-- 0. DESTRUCTIVE RESET — drop everything in `public`, recreate the schema,
--    and restore the grants Supabase's PostgREST layer needs (these are set
--    once at project creation and are NOT recreated automatically by
--    `CREATE SCHEMA` — skipping this step leaves every table returning
--    "permission denied for schema public" to your frontend/backend).
-- =============================================================================

DROP SCHEMA IF EXISTS public CASCADE;
CREATE SCHEMA public;

GRANT USAGE ON SCHEMA public TO postgres, anon, authenticated, service_role;

ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO postgres, anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO postgres, anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON FUNCTIONS TO postgres, anon, authenticated, service_role;

-- =============================================================================
-- 1. EXTENSIONS
-- =============================================================================
create extension if not exists pgcrypto;   -- gen_random_uuid()

-- =============================================================================
-- 2. CORE TABLES
-- =============================================================================

CREATE TABLE organizations (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    name varchar NOT NULL,
    owner_name varchar NOT NULL,
    phone varchar NOT NULL,
    owner_phone varchar(20),
    email varchar,
    address varchar,
    tax_id varchar,
    commercial_register varchar,
    business_type varchar,
    logo_url text,
    receipt_footer_text text,
    subscription_plan varchar,
    -- Denormalized copy of the active license's limits/expiry, synced by
    -- createLicense()/updateLicense() in superAdmin.service.ts. Source of
    -- truth is still `saaslicenses` (joined via saaslicenses.claimed_by_org_id),
    -- but keeping a copy here lets the app check "am I over my branch/employee
    -- limit?" or "is my plan expiring soon?" without a join on every request.
    max_branches integer,
    max_employees integer,
    subscription_end_date timestamptz,
    min_down_payment_pct numeric(5,2) DEFAULT 0.00,
    max_installment_months integer DEFAULT 36,
    is_active boolean DEFAULT true,
    created_at timestamptz DEFAULT now(),
    updated_at timestamptz DEFAULT now(),
    discount_cap_pct numeric(5,2) DEFAULT 0,
    discount_requires_approval boolean DEFAULT true,
    collector_commission_pct numeric(5,2) DEFAULT 0;
    CONSTRAINT organizations_pkey PRIMARY KEY (id),
    CONSTRAINT chk_org_subscription_plan CHECK (subscription_plan IS NULL OR subscription_plan IN ('STARTER', 'PROFESSIONAL', 'ENTERPRISE'))
);

CREATE TABLE saaslicenses (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    license_key varchar(50) NOT NULL UNIQUE,
    plan_name varchar(50),
    max_branches integer,
    max_employees integer,
    valid_months integer,
    is_used boolean DEFAULT false,
    is_active boolean DEFAULT true,
    claimed_by_org_id uuid REFERENCES organizations(id) ON DELETE SET NULL,
    subscription_end_date timestamptz,
    created_at timestamptz DEFAULT now(),
    CONSTRAINT saaslicenses_pkey PRIMARY KEY (id),
    CONSTRAINT chk_license_plan_name
        CHECK (plan_name IS NULL OR plan_name IN ('STARTER', 'PROFESSIONAL', 'ENTERPRISE')),
    -- A license can never be marked used without an org attached. Mirrors
    -- the application-level guard in activateWorkspace(), enforced here too.
    CONSTRAINT chk_used_license_has_org
        CHECK (is_used = false OR claimed_by_org_id IS NOT NULL)
    -- NOTE: org_name/org_phone/org_address/owner_name/owner_phone/owner_email/
    -- modules were removed here — they existed on the previous schema but
    -- were never written to or read by any code path. If you later want an
    -- immutable snapshot of provisioning details independent of the live
    -- `organizations` row, reintroduce them deliberately alongside the
    -- service-layer code that populates them, rather than carrying dead
    -- columns forward.
);

CREATE TABLE branches (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    organization_id uuid NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
    name varchar NOT NULL,
    branch_code varchar,
    address text NOT NULL,
    city varchar NOT NULL,
    governorate varchar,
    latitude numeric(10,8),
    longitude numeric(11,8),
    phone varchar NOT NULL,
    email varchar,
    is_main_branch boolean DEFAULT false,
    is_active boolean DEFAULT true,
    created_at timestamptz DEFAULT now(),
    updated_at timestamptz DEFAULT now(),
    CONSTRAINT branches_pkey PRIMARY KEY (id)
);

CREATE TABLE persons (
    id uuid NOT NULL DEFAULT gen_random_uuid(),
    organization_id uuid NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
    full_name varchar NULL,
    phone varchar NOT NULL,
    national_id varchar,
    address text,
    created_at timestamptz DEFAULT now(),
    CONSTRAINT persons_pkey PRIMARY KEY (id)
);

-- 1:1 with persons
CREATE TABLE employees (
    id uuid NOT NULL REFERENCES persons(id) ON DELETE CASCADE,
    auth_id uuid UNIQUE REFERENCES auth.users(id) ON DELETE SET NULL,
    organization_id uuid NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
    branch_id uuid REFERENCES branches(id) ON DELETE SET NULL,
    role varchar NOT NULL DEFAULT 'CASHIER',
    -- FIX: national_id removed — this table is 1:1 with `persons`, which
    -- already carries national_id. Having it in both places was two sources
    -- of truth for the same fact with no sync guarantee between them.
    username varchar,
    hire_date date DEFAULT CURRENT_DATE,
    base_salary numeric(10,2),
    is_active boolean DEFAULT true,
    phone varchar(20),
    permissions jsonb DEFAULT '[]'::jsonb,
    last_login_at timestamptz,
    created_at timestamptz DEFAULT now(),
    updated_at timestamptz DEFAULT now(),
    CONSTRAINT employees_pkey PRIMARY KEY (id),
    CONSTRAINT chk_employees_role
        CHECK (role IN ('OWNER', 'SUPER_ADMIN', 'MODERATOR', 'CASHIER', 'COLLECTOR', 'ACCOUNTANT', 'HR_MANAGER', 'WH_MANAGER', 'LAWYER'))
);

