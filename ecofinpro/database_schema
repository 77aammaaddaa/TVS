-- Existing trigger function (from the base script) that reacts to
-- inventory_transactions inserts (SALE / PURCHASE_RETURN / etc). It must set
-- the governance flag itself, since it legitimately changes stock_quantity.
CREATE OR REPLACE FUNCTION public.update_product_stock()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('app.allow_inventory_write', 'on', true);
    UPDATE public.products SET stock_quantity = stock_quantity + NEW.quantity_changed WHERE id = NEW.product_id;
    PERFORM set_config('app.allow_inventory_write', 'off', true);
    RETURN NEW;
END;
$$;
-- (trigger trigger_update_stock from the base script keeps pointing at this
-- function automatically — CREATE OR REPLACE does not disturb the binding)

-- Legacy helper from the base script — kept for backward compatibility but
-- superseded by trg_purchase_approval below. Wrapped so it doesn't trip the
-- new governance guard if anything still calls it directly.
CREATE OR REPLACE FUNCTION public.apply_purchase_to_product(
    p_product_id uuid, p_quantity int, p_unit_cost numeric,
    p_cash_price numeric, p_installment_price numeric
) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('app.allow_inventory_write', 'on', true);
    UPDATE public.products
    SET stock_quantity = stock_quantity + p_quantity,
        cost_price = p_unit_cost,
        cash_price = p_cash_price,
        installment_price = p_installment_price
    WHERE id = p_product_id;
    PERFORM set_config('app.allow_inventory_write', 'off', true);

    INSERT INTO public.inventory_transactions (
        organization_id, product_id, quantity_changed, transaction_type, reference_id, reference_table, employee_id
    ) VALUES (
        (SELECT organization_id FROM public.products WHERE id = p_product_id),
        p_product_id, p_quantity, 'PURCHASE', gen_random_uuid(), 'purchase_invoices', null
    );
END;
$$;

-- A) MOVING AVERAGE COST + ACCOUNTS PAYABLE — fires when a purchase invoice
--    transitions into APPROVED. Formula:
--    new_cost = ((old_qty * old_cost) + (new_qty * new_cost)) / (old_qty + new_qty)
CREATE OR REPLACE FUNCTION public.apply_purchase_approval()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  item record;
  v_old_qty integer;
  v_old_cost numeric;
  v_new_cost numeric;
BEGIN
  IF NEW.status = 'APPROVED' AND OLD.status IS DISTINCT FROM 'APPROVED' THEN
    PERFORM set_config('app.allow_inventory_write', 'on', true);

    FOR item IN SELECT * FROM public.purchase_items WHERE purchase_invoice_id = NEW.id
    LOOP
      SELECT stock_quantity, cost_price INTO v_old_qty, v_old_cost
      FROM public.products WHERE id = item.product_id FOR UPDATE;

      IF v_old_qty IS NULL THEN
        CONTINUE; -- product row missing/deleted; skip defensively
      END IF;

      IF (v_old_qty + item.quantity) = 0 THEN
        v_new_cost := item.unit_cost;
      ELSE
        v_new_cost := ((v_old_qty * v_old_cost) + (item.quantity * item.unit_cost))
                      / (v_old_qty + item.quantity);
      END IF;

      UPDATE public.products
      SET stock_quantity = stock_quantity + item.quantity,
          cost_price = round(v_new_cost, 2)
      WHERE id = item.product_id;

      INSERT INTO public.inventory_transactions (
        organization_id, product_id, quantity_changed, transaction_type, reference_id, reference_table, employee_id
      ) VALUES (
        NEW.organization_id, item.product_id, item.quantity, 'PURCHASE', NEW.id, 'purchase_invoices', NEW.approved_by
      );
    END LOOP;

    PERFORM set_config('app.allow_inventory_write', 'off', true);

    -- Accounts payable debt is created here — nothing hits the vault yet.
    NEW.outstanding_amount := NEW.total_amount - COALESCE(NEW.amount_paid, 0);
    NEW.approved_at := COALESCE(NEW.approved_at, now());
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_purchase_approval ON public.purchase_invoices;
CREATE TRIGGER trg_purchase_approval
BEFORE UPDATE ON public.purchase_invoices
FOR EACH ROW EXECUTE FUNCTION public.apply_purchase_approval();

-- B) PURCHASE SETTLEMENT — deducts the payout vault, reduces the payable
CREATE OR REPLACE FUNCTION public.process_purchase_settlement()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  UPDATE public.vaults SET balance = balance - NEW.amount WHERE id = NEW.vault_id;

  UPDATE public.purchase_invoices
  SET amount_paid = amount_paid + NEW.amount,
      outstanding_amount = GREATEST(outstanding_amount - NEW.amount, 0)
  WHERE id = NEW.purchase_invoice_id;

  INSERT INTO public.vault_transactions (organization_id, source_vault_id, amount, transaction_type, employee_id)
  VALUES (NEW.organization_id, NEW.vault_id, NEW.amount, 'PURCHASE_SETTLEMENT', NEW.employee_id);

  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_process_purchase_settlement ON public.purchase_settlements;
CREATE TRIGGER trg_process_purchase_settlement
AFTER INSERT ON public.purchase_settlements
FOR EACH ROW EXECUTE FUNCTION public.process_purchase_settlement();

-- C) PURCHASE RETURN — deducts stock, adjusts the payable downward
CREATE OR REPLACE FUNCTION public.process_purchase_return()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  PERFORM set_config('app.allow_inventory_write', 'on', true);
  UPDATE public.products SET stock_quantity = stock_quantity - NEW.quantity WHERE id = NEW.product_id;
  PERFORM set_config('app.allow_inventory_write', 'off', true);

  INSERT INTO public.inventory_transactions (organization_id, product_id, quantity_changed, transaction_type, reference_id, reference_table)
  VALUES (NEW.organization_id, NEW.product_id, -NEW.quantity, 'PURCHASE_RETURN', NEW.purchase_return_id, 'purchase_returns');

  UPDATE public.purchase_invoices pi
  SET outstanding_amount = GREATEST(outstanding_amount - (NEW.quantity * NEW.unit_cost), 0)
  FROM public.purchase_returns pr
  WHERE pr.id = NEW.purchase_return_id AND pi.id = pr.purchase_invoice_id;

  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_process_purchase_return ON public.purchase_return_items;
CREATE TRIGGER trg_process_purchase_return
AFTER INSERT ON public.purchase_return_items
FOR EACH ROW EXECUTE FUNCTION public.process_purchase_return();

-- D) SHIFT CONCURRENCY LIMIT — max 2 OPEN shifts per branch at any time
CREATE OR REPLACE FUNCTION public.enforce_shift_concurrency()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_count int;
BEGIN
  IF NEW.status = 'OPEN' THEN
    SELECT count(*) INTO v_count FROM public.shift_sessions
    WHERE branch_id = NEW.branch_id
      AND status = 'OPEN'
      AND id <> COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::uuid);
    IF v_count >= 2 THEN
      RAISE EXCEPTION 'الحد الأقصى لعدد الورديات المفتوحة في هذا الفرع هو 2';
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_shift_concurrency ON public.shift_sessions;
CREATE TRIGGER trg_shift_concurrency
BEFORE INSERT OR UPDATE ON public.shift_sessions
FOR EACH ROW EXECUTE FUNCTION public.enforce_shift_concurrency();

-- E) SHIFT CLOSE — auto-transfer drawer balance to Main Vault + shortage flag
CREATE OR REPLACE FUNCTION public.close_shift_transfer()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  v_main_vault uuid;
  v_diff numeric;
BEGIN
  IF NEW.status = 'CLOSED' AND OLD.status IS DISTINCT FROM 'CLOSED' THEN
    v_diff := COALESCE(NEW.actual_closing_balance, 0) - COALESCE(NEW.expected_closing_balance, 0);
    NEW.difference_amount := v_diff;
    NEW.shortage_status := CASE WHEN v_diff < 0 THEN 'عجز' ELSE NULL END;
    NEW.closed_at := COALESCE(NEW.closed_at, now());

    SELECT id INTO v_main_vault FROM public.vaults
    WHERE organization_id = NEW.organization_id AND is_main_vault = true LIMIT 1;

    IF v_main_vault IS NULL THEN
      RAISE EXCEPTION 'No main vault configured for organization %', NEW.organization_id;
    END IF;

    IF NEW.vault_id IS NOT NULL AND NEW.vault_id <> v_main_vault THEN
      UPDATE public.vaults SET balance = balance - COALESCE(NEW.actual_closing_balance, 0) WHERE id = NEW.vault_id;
      UPDATE public.vaults SET balance = balance + COALESCE(NEW.actual_closing_balance, 0) WHERE id = v_main_vault;

      INSERT INTO public.vault_transactions (organization_id, source_vault_id, destination_vault_id, amount, transaction_type, employee_id)
      VALUES (NEW.organization_id, NEW.vault_id, v_main_vault, COALESCE(NEW.actual_closing_balance, 0), 'SHIFT_SETTLEMENT', NEW.employee_id);
    END IF;

    NEW.transferred_to_vault := true;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_close_shift_transfer ON public.shift_sessions;
CREATE TRIGGER trg_close_shift_transfer
BEFORE UPDATE ON public.shift_sessions
FOR EACH ROW EXECUTE FUNCTION public.close_shift_transfer();

-- F) INSTALLMENT OVERPAYMENT CASCADE — a collection payment (is_collection =
--    true, no specific installment targeted) is applied to the earliest
--    unpaid installment first, then cascades any excess forward in
--    chronological order.
CREATE OR REPLACE FUNCTION public.cascade_installment_payment()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  v_remaining numeric := NEW.amount;
  inst record;
  v_applied numeric;
BEGIN
  IF NEW.is_collection IS TRUE AND NEW.contract_id IS NOT NULL THEN
    FOR inst IN
      SELECT * FROM public.installments
      WHERE contract_id = NEW.contract_id AND status <> 'PAID'
      ORDER BY due_date ASC
      FOR UPDATE
    LOOP
      EXIT WHEN v_remaining <= 0;
      v_applied := LEAST(v_remaining, inst.amount - inst.paid_amount);

      UPDATE public.installments
      SET paid_amount = paid_amount + v_applied,
          status = CASE WHEN (paid_amount + v_applied) >= amount THEN 'PAID' ELSE 'PARTIALLY_PAID' END
      WHERE id = inst.id;

      v_remaining := v_remaining - v_applied;
    END LOOP;

    IF v_remaining > 0 THEN
      RAISE NOTICE 'Overpayment of % on contract % exceeds total remaining installments — leaving as unapplied credit', v_remaining, NEW.contract_id;
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_cascade_installment_payment ON public.payments;
CREATE TRIGGER trg_cascade_installment_payment
AFTER INSERT ON public.payments
FOR EACH ROW EXECUTE FUNCTION public.cascade_installment_payment();

-- G) COLLECTOR WALLET CREDIT + COMMISSION — a collection payment that
--    carries a wallet_id credits the full collected cash into that wallet's
--    drawer and pays out the org's commission percentage.
CREATE OR REPLACE FUNCTION public.apply_collector_commission()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  v_pct numeric;
  v_commission numeric;
BEGIN
  IF NEW.is_collection IS TRUE AND NEW.wallet_id IS NOT NULL THEN
    UPDATE public.wallets SET balance = balance + NEW.amount WHERE id = NEW.wallet_id;
    INSERT INTO public.wallet_transactions (organization_id, wallet_id, amount, transaction_type, payment_id)
    VALUES (NEW.organization_id, NEW.wallet_id, NEW.amount, 'COLLECTION', NEW.id);

    SELECT collector_commission_pct INTO v_pct FROM public.organizations WHERE id = NEW.organization_id;
    v_commission := round(NEW.amount * COALESCE(v_pct, 0) / 100, 2);

    IF v_commission > 0 THEN
      UPDATE public.wallets SET balance = balance + v_commission WHERE id = NEW.wallet_id;
      INSERT INTO public.wallet_transactions (organization_id, wallet_id, amount, transaction_type, payment_id)
      VALUES (NEW.organization_id, NEW.wallet_id, v_commission, 'COMMISSION', NEW.id);
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_apply_collector_commission ON public.payments;
CREATE TRIGGER trg_apply_collector_commission
AFTER INSERT ON public.payments
FOR EACH ROW EXECUTE FUNCTION public.apply_collector_commission();

