-- Governance guard: any UPDATE touching cost_price / stock_quantity /
-- product_type is rejected unless a trusted trigger has flipped the session
-- flag app.allow_inventory_write = 'on' first. Because this fires as a
-- regular trigger (not RLS), it applies even to the backend's service-role
-- connection — the only way around it is through the flows below.
CREATE OR REPLACE FUNCTION public.enforce_product_governance()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF (NEW.cost_price IS DISTINCT FROM OLD.cost_price
      OR NEW.stock_quantity IS DISTINCT FROM OLD.stock_quantity
      OR NEW.product_type IS DISTINCT FROM OLD.product_type)
     AND coalesce(current_setting('app.allow_inventory_write', true), 'off') <> 'on' THEN
    RAISE EXCEPTION 'cost_price, stock_quantity and product_type can only change via an approved purchase invoice, purchase return, or POS sale';
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_products_governance ON public.products;
CREATE TRIGGER trg_products_governance
BEFORE UPDATE ON public.products
FOR EACH ROW EXECUTE FUNCTION public.enforce_product_governance();

