CREATE OR REPLACE FUNCTION process_partner_capital()
RETURNS trigger AS $$
DECLARE
    total_capital numeric;
BEGIN
    -- Only react when a row becomes APPROVED (INSERT or UPDATE)
    IF (TG_OP = 'INSERT' AND NEW.status = 'APPROVED') OR
       (TG_OP = 'UPDATE' AND NEW.status = 'APPROVED' AND OLD.status <> 'APPROVED') THEN

        -- Update vault balance
        IF NEW.transaction_type = 'DEPOSIT' THEN
            UPDATE vaults SET balance = balance + NEW.amount WHERE id = NEW.vault_id;
        ELSIF NEW.transaction_type = 'WITHDRAWAL' THEN
            UPDATE vaults SET balance = balance - NEW.amount WHERE id = NEW.vault_id;
        END IF;

        -- Update partner's current capital
        IF NEW.transaction_type = 'DEPOSIT' THEN
            UPDATE partners SET current_capital = current_capital + NEW.amount
            WHERE id = NEW.partner_id;
        ELSIF NEW.transaction_type = 'WITHDRAWAL' THEN
            UPDATE partners SET current_capital = current_capital - NEW.amount
            WHERE id = NEW.partner_id;
        END IF;

        -- Recalculate profit‑share percentages for ALL active partners in the org
        SELECT COALESCE(SUM(current_capital), 0) INTO total_capital
        FROM partners
        WHERE organization_id = NEW.organization_id AND status = 'ACTIVE';

        UPDATE partners
        SET profit_share_percentage = CASE
            WHEN total_capital > 0 THEN ROUND((current_capital::numeric / total_capital) * 100, 2)
            ELSE 0
        END
        WHERE organization_id = NEW.organization_id AND status = 'ACTIVE';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_process_partner_capital
  AFTER INSERT OR UPDATE ON partner_transactions
  FOR EACH ROW
  EXECUTE FUNCTION process_partner_capital();

