-- Product Cost History – logs every cost_price change on products
-- =============================================================================

-- 1. Log table
CREATE TABLE IF NOT EXISTS public.product_cost_log (
    id              uuid NOT NULL DEFAULT gen_random_uuid(),
    product_id      uuid NOT NULL REFERENCES public.products(id) ON DELETE CASCADE,
    old_cost        numeric(12,2),
    new_cost        numeric(12,2),
    changed_at      timestamptz NOT NULL DEFAULT now(),
    changed_by      uuid REFERENCES public.employees(id) ON DELETE SET NULL,
    reference_type  varchar,               -- e.g. 'PURCHASE_APPROVAL', 'MANUAL_OVERRIDE'
    reference_id    uuid,                  -- e.g. purchase_invoice id
    organization_id uuid NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
    CONSTRAINT product_cost_log_pkey PRIMARY KEY (id)
);

-- 2. Trigger function – fires on products UPDATE where cost_price changes
CREATE OR REPLACE FUNCTION public.log_product_cost_change()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
    IF (OLD.cost_price IS DISTINCT FROM NEW.cost_price) THEN
        INSERT INTO public.product_cost_log (
            product_id,
            old_cost,
            new_cost,
            changed_at,
            organization_id,
            reference_type,
            reference_id
        ) VALUES (
            NEW.id,
            OLD.cost_price,
            NEW.cost_price,
            now(),
            NEW.organization_id,
            COALESCE(current_setting('app.cost_change_reference_type', true), 'MANUAL'),
            COALESCE(current_setting('app.cost_change_reference_id', true)::uuid, NULL)
        );
    END IF;
    RETURN NEW;
END;
$$;

-- 3. Attach trigger
DROP TRIGGER IF EXISTS trg_log_product_cost ON public.products;
CREATE TRIGGER trg_log_product_cost
    AFTER UPDATE ON public.products
    FOR EACH ROW
    EXECUTE FUNCTION public.log_product_cost_change();

