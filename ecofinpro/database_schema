              'shift_sessions', 'purchase_invoices', 'purchase_items',
              'legal_documents', 'legal_cases', 'legal_attachments'
          )
    LOOP
        EXECUTE format('
            CREATE POLICY %I ON public.%I
            FOR SELECT
            USING (public.tenant_policy_check(organization_id));
        ', table_name || '_select', table_name);

        EXECUTE format('
            CREATE POLICY %I ON public.%I
            FOR INSERT
            WITH CHECK (public.tenant_policy_check(organization_id));
        ', table_name || '_insert', table_name);

        EXECUTE format('
            CREATE POLICY %I ON public.%I
            FOR UPDATE
            USING (public.tenant_policy_check(organization_id))
            WITH CHECK (public.tenant_policy_check(organization_id));
        ', table_name || '_update', table_name);

        EXECUTE format('
            CREATE POLICY %I ON public.%I
            FOR DELETE
            USING (public.tenant_policy_check(organization_id));
        ', table_name || '_delete', table_name);
    END LOOP;
END;
$$;

DO $$
