CREATE OR REPLACE FUNCTION public.create_pos_sale(
    p_organization_id uuid,
    p_branch_id uuid,
    p_employee_id uuid,
    p_sale_type text,
    p_items jsonb,           -- array of {product_id, quantity}
    p_customer_id uuid DEFAULT NULL,
    p_shipping_fee numeric DEFAULT 0,
    p_down_payment numeric DEFAULT 0,
    p_installment_count int DEFAULT NULL,
    p_notes text DEFAULT NULL
) RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
    v_shift record;
    v_product record;
    v_line_items jsonb;
    v_subtotal numeric := 0;
    v_total_amount numeric := 0;
    v_remaining_amount numeric := 0;
    v_payment_amount numeric := 0;
    v_contract_id uuid;
    v_installment_per numeric;
    v_due_date date;
    i int;
    v_item jsonb;
    v_contract_status text;
    v_ref_id text;
BEGIN
    -- 1. Verify open shift (throw if none)
    SELECT id, vault_id, status INTO v_shift
    FROM public.shift_sessions
    WHERE employee_id = p_employee_id
      AND organization_id = p_organization_id
      AND status = 'OPEN'
    LIMIT 1;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'لا توجد وردية مفتوحة لهذا الموظف.';
    END IF;

    -- 2. Price & stock validation (iterate items)
    v_subtotal := 0;
    FOR v_item IN SELECT * FROM jsonb_array_elements(p_items)
    LOOP
        SELECT id, name, stock_quantity,
               CASE WHEN p_sale_type = 'INSTALLMENT' THEN installment_price ELSE cash_price END
        INTO v_product
        FROM public.products
        WHERE id = (v_item->>'product_id')::uuid
          AND organization_id = p_organization_id;

        IF NOT FOUND THEN
            RAISE EXCEPTION 'المنتج غير موجود: %', v_item->>'product_id';
        END IF;

        IF v_product.stock_quantity < (v_item->>'quantity')::int THEN
            RAISE EXCEPTION 'الكمية غير كافية للمنتج %', v_product.name;
        END IF;

        v_subtotal := v_subtotal + (v_product.cash_price * (v_item->>'quantity')::int);
    END LOOP;

    -- 3. Compute totals
    v_total_amount := v_subtotal;
    IF p_sale_type = 'SHIPPING' THEN
        v_total_amount := v_total_amount + p_shipping_fee;
    END IF;

    IF p_sale_type = 'INSTALLMENT' THEN
        v_remaining_amount := v_total_amount - p_down_payment;
        IF v_remaining_amount < 0 THEN
            RAISE EXCEPTION 'المقدم أكبر من إجمالي الفاتورة.';
        END IF;
        -- Credit check can be added here, but skip for brevity (you can move it in)
    END IF;

    v_contract_status := CASE WHEN p_sale_type = 'INSTALLMENT' THEN 'ACTIVE' ELSE 'COMPLETED' END;

    -- 4. All writes in a single transaction
    -- The function is already a single transaction; any error will ROLLBACK.

    -- Insert contract
    INSERT INTO public.contracts (
        organization_id, branch_id, customer_id, employee_id,
        sale_type, total_amount, remaining_amount,
        down_payment, shipping_fee, status
    ) VALUES (
        p_organization_id, p_branch_id, p_customer_id, p_employee_id,
        p_sale_type, v_total_amount, v_remaining_amount,
        p_down_payment, p_shipping_fee, v_contract_status
    ) RETURNING id INTO v_contract_id;

    -- Insert contract items + deduct stock
    FOR v_item IN SELECT * FROM jsonb_array_elements(p_items)
    LOOP
        INSERT INTO public.contract_items (
            organization_id, contract_id, product_id,
            quantity, unit_price
        ) VALUES (
            p_organization_id, v_contract_id,
            (v_item->>'product_id')::uuid,
            (v_item->>'quantity')::int,
            CASE WHEN p_sale_type = 'INSTALLMENT'
                 THEN (SELECT installment_price FROM products WHERE id = (v_item->>'product_id')::uuid)
                 ELSE (SELECT cash_price FROM products WHERE id = (v_item->>'product_id')::uuid)
            END
        );

        -- Insert inventory transaction (trigger updates stock)
        INSERT INTO public.inventory_transactions (
            organization_id, product_id,
            quantity_changed, transaction_type,
            reference_id, reference_table, employee_id
        ) VALUES (
            p_organization_id, (v_item->>'product_id')::uuid,
            -(v_item->>'quantity')::int, 'SALE',
            v_contract_id, 'contracts', p_employee_id
        );
    END LOOP;

    -- Installments (if installment)
    IF p_sale_type = 'INSTALLMENT' AND p_installment_count > 0 THEN
        v_installment_per := round(v_remaining_amount / p_installment_count, 2);
        v_due_date := date_trunc('month', now())::date;
        FOR i IN 1..p_installment_count LOOP
            v_due_date := v_due_date + interval '1 month';
            -- Adjust last installment to make sum exactly remaining
            IF i = p_installment_count THEN
                v_installment_per := v_remaining_amount - (v_installment_per * (i-1));
            END IF;
            INSERT INTO public.installments (
                organization_id, contract_id,
                due_date, amount,
                principal_portion, profit_portion, status
            ) VALUES (
                p_organization_id, v_contract_id,
                v_due_date, v_installment_per,
                v_installment_per, 0, 'PENDING'
            );
        END LOOP;
    END IF;

    -- Payment
    v_payment_amount := CASE WHEN p_sale_type = 'INSTALLMENT' THEN p_down_payment ELSE v_total_amount END;
    IF v_payment_amount > 0 THEN
        INSERT INTO public.payments (
            organization_id, contract_id,
            vault_id, amount,
            payment_method, employee_id
        ) VALUES (
            p_organization_id, v_contract_id,
            v_shift.vault_id, v_payment_amount,
            CASE WHEN p_sale_type = 'INSTALLMENT' THEN 'DOWN_PAYMENT' ELSE 'CASH' END,
            p_employee_id
        );
    END IF;

    -- Return result
    v_ref_id := upper(substring(v_contract_id::text, 1, 8));
    RETURN jsonb_build_object(
        'contract_id', v_contract_id,
        'sale_type', p_sale_type,
        'total_amount', v_total_amount,
        'remaining_amount', v_remaining_amount,
        'status', v_contract_status,
        'receipt_ref', v_ref_id
    );
END;
$$;
