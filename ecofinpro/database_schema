-- B. Standard tenant-scoped tables — generate SELECT/INSERT/UPDATE/DELETE
--    policies for every table below in one pass.

DO $$
DECLARE
    table_name text;
BEGIN
    FOR table_name IN
        SELECT tablename FROM pg_tables
        WHERE schemaname = 'public'
          AND tablename IN (
              'branches', 'persons', 'employees', 'notifications', 'audit_logs',
              'customers', 'guarantors', 'client_guarantors', 'categories', 'suppliers',
              'vaults', 'products', 'contracts', 'contract_items', 'installments',
