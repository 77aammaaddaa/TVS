CREATE OR REPLACE FUNCTION public.transfer_between_vaults(
    p_org_id uuid,
    p_from_vault uuid,
    p_to_vault uuid,
    p_amount numeric,
    p_employee_id uuid,
    p_description text DEFAULT NULL
) RETURNS void LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
    v_balance numeric;
BEGIN
    -- Lock source row
    SELECT balance INTO v_balance FROM public.vaults
    WHERE id = p_from_vault AND organization_id = p_org_id FOR UPDATE;
    IF NOT FOUND THEN RAISE EXCEPTION 'Source vault not found'; END IF;
    IF v_balance < p_amount THEN RAISE EXCEPTION 'Insufficient balance'; END IF;

    -- Update source
    UPDATE public.vaults SET balance = balance - p_amount WHERE id = p_from_vault;
    -- Update destination
    UPDATE public.vaults SET balance = balance + p_amount WHERE id = p_to_vault;

    -- Insert transaction record (both legs)
    INSERT INTO public.vault_transactions
        (organization_id, source_vault_id, destination_vault_id, amount, transaction_type, employee_id, description)
    VALUES
        (p_org_id, p_from_vault, p_to_vault, p_amount, 'TRANSFER', p_employee_id, p_description);
END;
$$;

