-- Payment -> update vault balance & log transaction
CREATE OR REPLACE FUNCTION public.process_payment_to_vault()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
    UPDATE public.vaults SET balance = balance + NEW.amount WHERE id = NEW.vault_id;
    INSERT INTO public.vault_transactions (organization_id, destination_vault_id, amount, transaction_type, payment_id, employee_id)
    VALUES (NEW.organization_id, NEW.vault_id, NEW.amount, 'CUSTOMER_PAYMENT', NEW.id, NEW.employee_id);
    RETURN NEW;
END;
$$;

