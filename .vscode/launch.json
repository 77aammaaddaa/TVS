{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Local Debugging Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/debug_agent.py",
      "args": ["--path", "${workspaceFolder}", "--error", "TypeError: Cannot read properties of undefined"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
